//@version=5
// ─────────────────────────────────────────────────────────────────────────────
// QRE SCREENER — indicator companion to "Quant Regime Ensemble [QRE]"
//
// TradingView's Pine Screener only accepts INDICATORS, so this mirrors the
// strategy's entry logic exactly (stock-preset defaults) and exposes it as
// numeric columns you can filter a watchlist on:
//
//   Signal      2 = TREND-LONG breakout fired this bar
//               1 = MR-LONG (mean-reversion) fired this bar
//               0 = no entry
//   Regime      1 = TREND, -1 = RANGE, 0 = TRANSITION / vol blowout
//   RS OK       1 = outperforming benchmark (longs allowed), 0 = laggard
//   Vol Blowout 1 = ATR above circuit-breaker percentile (no entries)
//   Stop Price  suggested initial stop if entering on this bar
//   Qty /100k   suggested share qty per $100k equity slice
//   ATR %       ATR as % of price (informational)
//
// Keep the inputs identical to your strategy settings or the screener and the
// chart will disagree. Defaults here = validated stock preset.
// ─────────────────────────────────────────────────────────────────────────────
indicator("QRE Screener", shorttitle = "QRE-SCR", overlay = false, max_bars_back = 500)

// ── inputs (mirror the strategy's stock-preset defaults) ──
erLen      = input.int(20,    "Efficiency Ratio length")
erTrendTh  = input.float(0.25,"ER trend threshold", step = 0.05)
regLen     = input.int(50,    "Regression length (t-stat)")
tStatTh    = input.float(2.0, "Slope |t-stat| significance", step = 0.25)
adxLen     = input.int(14,    "ADX length")
adxTh      = input.float(20,  "ADX trend threshold")
volLookback= input.int(252,   "Vol percentile lookback")
volCapPct  = input.float(97,  "Vol circuit-breaker percentile")
kamaLen    = input.int(20,    "KAMA length")
kamaFast   = input.int(2,     "KAMA fast EMA")
kamaSlow   = input.int(30,    "KAMA slow EMA")
donLen     = input.int(20,    "Donchian breakout length")
zLen       = input.int(20,    "Z-score length")
zEntry     = input.float(2.0, "Z-score entry (|z|)", step = 0.25)
rsiLen     = input.int(2,     "Fast RSI length")
rsiOS      = input.float(10,  "RSI oversold")
riskPct    = input.float(1.0, "Risk per trade (% of slice)", step = 0.1)
atrLen     = input.int(14,    "ATR length")
atrStopMult= input.float(2.5, "Initial stop (ATR mult)", step = 0.25)
useRsFilter= input.bool(true, "Relative-strength filter")
rsSymbol   = input.symbol("SPY", "Benchmark")
rsLen      = input.int(50,    "RS ratio SMA length")
gapAtrMult = input.float(2.0, "Gap-shock threshold (ATR, 0=off)", step = 0.25)
maxNotionalPct = input.float(20, "Max position notional (% slice)")
sliceEquity = input.float(100000, "Equity slice for qty column ($)")

// ── statistical components (identical to the strategy) ──
change_  = math.abs(close - close[erLen])
path_    = math.sum(math.abs(close - close[1]), erLen)
er       = path_ > 0 ? change_ / path_ : 0.0

xMean    = (regLen - 1) / 2.0
yMean    = math.sum(close, regLen) / regLen
float sxy = 0.0
float sxx = 0.0
for i = 0 to regLen - 1
    x  = regLen - 1 - i
    dx = x - xMean
    sxy := sxy + dx * (close[i] - yMean)
    sxx := sxx + dx * dx
slope    = sxx > 0 ? sxy / sxx : 0.0
float sse = 0.0
for i = 0 to regLen - 1
    x    = regLen - 1 - i
    yhat = yMean + slope * (x - xMean)
    e    = close[i] - yhat
    sse := sse + e * e
seSlope  = sxx > 0 and regLen > 2 ? math.sqrt((sse / (regLen - 2)) / sxx) : na
tStat    = not na(seSlope) and seSlope > 0 ? slope / seSlope : 0.0

[diPlus, diMinus, adxV] = ta.dmi(adxLen, adxLen)
atr      = ta.atr(atrLen)
volPctile = ta.percentrank(atr, volLookback)
volBlowout = volPctile >= volCapPct

isTrending = er > erTrendTh and (math.abs(tStat) > tStatTh or adxV > adxTh)
isRanging  = er < erTrendTh * 0.8 and math.abs(tStat) < tStatTh and adxV < adxTh
regime     = volBlowout ? 0 : isTrending ? 1 : isRanging ? -1 : 0

fastSC   = 2.0 / (kamaFast + 1)
slowSC   = 2.0 / (kamaSlow + 1)
erK      = math.abs(close - close[kamaLen]) / math.max(math.sum(math.abs(close - close[1]), kamaLen), 1e-10)
sc       = math.pow(erK * (fastSC - slowSC) + slowSC, 2)
var float kama = na
kama    := na(kama[1]) ? close : kama[1] + sc * (close - kama[1])

donHi    = ta.highest(high, donLen)[1]
basis    = ta.sma(close, zLen)
sd       = ta.stdev(close, zLen)
z        = sd > 0 ? (close - basis) / sd : 0.0
rsiF     = ta.rsi(close, rsiLen)

benchClose = request.security(rsSymbol, timeframe.period, close, barmerge.gaps_off, barmerge.lookahead_off)
rsRatio    = not na(benchClose) and benchClose > 0 ? close / benchClose : 1.0
rsSma      = ta.sma(rsRatio, rsLen)
// syminfo.ticker is a variable, not a function - compare the input string
// against both the plain ticker and the exchange-prefixed form
rsActive   = useRsFilter and rsSymbol != syminfo.ticker and rsSymbol != syminfo.tickerid
rsOk       = not rsActive or rsRatio > rsSma

gapAtr     = atr[1] > 0 ? (open - close[1]) / atr[1] : 0.0
gapDay     = gapAtrMult > 0 and math.abs(gapAtr) > gapAtrMult

// ── entry signals (identical gating to the strategy) ──
trendLong = rsOk and isTrending and close > kama and slope > 0 and close > donHi and not volBlowout and not gapDay
mrLong    = rsOk and isRanging  and z < -zEntry and rsiF < rsiOS and not volBlowout and not gapDay
signal    = trendLong ? 2 : mrLong ? 1 : 0

stopDist  = atrStopMult * atr
qty       = stopDist > 0 ? math.min(math.floor(sliceEquity * riskPct / 100.0 / stopDist), math.floor(sliceEquity * maxNotionalPct / 100.0 / close)) : 0

// ── screener columns ──
plot(signal,              "Signal")
plot(regime,              "Regime")
plot(rsOk ? 1 : 0,        "RS OK")
plot(volBlowout ? 1 : 0,  "Vol Blowout")
plot(close - stopDist,    "Stop Price")
plot(qty,                 "Qty /100k")
plot(atr / close * 100,   "ATR %")
plot(z,                   "Z-score")
plot(er,                  "Eff Ratio")

// optional per-symbol alert from the indicator (lighter than strategy alerts)
alertcondition(signal > 0, "QRE entry signal", "QRE entry on {{ticker}}: signal fired (2=trend breakout, 1=mean reversion)")
