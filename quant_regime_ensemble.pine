//@version=5
// ─────────────────────────────────────────────────────────────────────────────
// QUANT REGIME ENSEMBLE [QRE]
//
// A regime-switching strategy that combines technical analysis with
// statistical models:
//
//   1. REGIME CLASSIFIER (statistical layer)
//      • Kaufman Efficiency Ratio  → trendiness of price path
//      • Rolling linear-regression slope t-statistic → trend significance
//      • ADX → directional strength confirmation
//      • ATR percentile rank (1yr lookback) → volatility regime
//
//   2. SIGNAL ENGINES (technical layer, routed by regime)
//      • TREND ENGINE  : KAMA baseline + Donchian breakout confirmation
//      • REVERSION ENGINE: z-score of price vs rolling mean (Bollinger
//        framework) + RSI(2) exhaustion, faded back to the mean
//
//   3. RISK ENGINE
//      • Volatility-targeted position sizing (fixed % equity risk / ATR stop)
//      • ATR initial stop + chandelier trailing stop
//      • Time stop on mean-reversion trades
//      • Volatility circuit breaker (stand aside in vol blowouts)
//
// Alerts fire JSON payloads suitable for webhook automation.
// ─────────────────────────────────────────────────────────────────────────────
strategy("Quant Regime Ensemble [QRE]",
     shorttitle   = "QRE",
     overlay      = true,
     initial_capital = 100000,
     currency     = currency.USD,
     default_qty_type = strategy.fixed,
     commission_type  = strategy.commission.percent,
     commission_value = 0.05,
     slippage     = 2,
     calc_on_every_tick = false,
     process_orders_on_close = true,
     max_labels_count = 500,
     max_bars_back = 500)

// ════════════════════════════════ INPUTS ════════════════════════════════════
grpRegime = "Regime Classifier"
erLen      = input.int(20,  "Efficiency Ratio length",        minval = 5,  group = grpRegime)
erTrendTh  = input.float(0.25, "ER trend threshold",          minval = 0.1, maxval = 0.9, step = 0.05, group = grpRegime)
regLen     = input.int(50,  "Regression length (t-stat)",     minval = 20, group = grpRegime)
tStatTh    = input.float(2.0, "Slope |t-stat| significance",  minval = 0.5, step = 0.25, group = grpRegime)
adxLen     = input.int(14,  "ADX length",                     minval = 5,  group = grpRegime)
adxTh      = input.float(20, "ADX trend threshold",           minval = 10, group = grpRegime)
volLookback= input.int(252, "Vol percentile lookback",        minval = 50, group = grpRegime)
volCapPct  = input.float(97, "Vol circuit-breaker percentile", minval = 50, maxval = 100, group = grpRegime, tooltip = "Flatten and stand aside when ATR exceeds this percentile of its 1yr range. 97 = true tail events only. Lower values (90) eject structurally volatile names (semis, small caps) mid-rally — validated worse on stocks, neutral on indices.")

grpTrend = "Trend Engine"
kamaLen    = input.int(20, "KAMA length",            minval = 5,  group = grpTrend)
kamaFast   = input.int(2,  "KAMA fast EMA",          minval = 1,  group = grpTrend)
kamaSlow   = input.int(30, "KAMA slow EMA",          minval = 5,  group = grpTrend)
donLen     = input.int(20, "Donchian breakout length", minval = 5, group = grpTrend)

grpMR = "Mean-Reversion Engine"
zLen       = input.int(20,   "Z-score length",       minval = 10, group = grpMR)
zEntry     = input.float(2.0,"Z-score entry (|z|)",  minval = 1.0, step = 0.25, group = grpMR)
zExit      = input.float(0.5,"Z-score exit (|z|)",   minval = 0.0, step = 0.25, group = grpMR)
rsiLen     = input.int(2,    "Fast RSI length",      minval = 2,  group = grpMR)
rsiOS      = input.float(10, "RSI oversold",         minval = 1,  maxval = 40, group = grpMR)
rsiOB      = input.float(90, "RSI overbought",       minval = 60, maxval = 99, group = grpMR)
mrTimeStop = input.int(10,   "MR time stop (bars)",  minval = 1,  group = grpMR)

grpRisk = "Risk Engine"
riskPct    = input.float(1.0, "Risk per trade (% equity)", minval = 0.1, maxval = 5, step = 0.1, group = grpRisk)
atrLen     = input.int(14,   "ATR length",                 minval = 5,  group = grpRisk)
atrStopMult= input.float(2.5,"Initial stop (ATR mult)",    minval = 0.5, step = 0.25, group = grpRisk)
chandMult  = input.float(5.0,"Chandelier trail (ATR mult)",minval = 1.0, step = 0.25, group = grpRisk)
allowShorts= input.bool(false, "Allow shorts",             group = grpRisk)
allowMR    = input.bool(true, "Enable mean-reversion engine", group = grpRisk)
allowTrend = input.bool(true, "Enable trend engine",       group = grpRisk)

grpStock = "Single-Stock Defenses"
useRsFilter = input.bool(true,  "Relative-strength filter (longs only in leaders)", group = grpStock, tooltip = "Longs allowed only when this symbol is outperforming the benchmark (ratio above its own SMA). Auto-disabled when the chart symbol IS the benchmark.")
rsSymbol    = input.symbol("SPY", "Benchmark", group = grpStock)
rsLen       = input.int(50, "RS ratio SMA length", minval = 10, group = grpStock)
gapAtrMult  = input.float(2.0, "Gap-shock threshold (ATR mult, 0 = off)", minval = 0.0, step = 0.25, group = grpStock, tooltip = "Adverse overnight gap beyond this many ATRs exits the position (earnings-shock defense) and blocks new entries that day. Set 0 to disable (e.g. on indices/24h markets).")
maxNotionalPct = input.float(20, "Max position notional (% equity)", minval = 1, maxval = 100, group = grpStock, tooltip = "Caps position size — ATR risk sizing alone over-allocates to low-volatility names.")

grpUI = "Display"
showRegime = input.bool(true, "Show regime background", group = grpUI)
showTable  = input.bool(true, "Show stats table",       group = grpUI)

// ═══════════════════════ STATISTICAL COMPONENTS ══════════════════════════════
// --- Kaufman Efficiency Ratio: |net move| / path length. ~1 = clean trend,
//     ~0 = noise. This is the primary trend/chop discriminator.
change_  = math.abs(close - close[erLen])
path_    = math.sum(math.abs(close - close[1]), erLen)
er       = path_ > 0 ? change_ / path_ : 0.0

// --- Rolling OLS slope t-statistic. Slope significance tells us whether the
//     drift is distinguishable from noise (the "is there a trend, statistically"
//     question, not just "does it look like one").
xMean    = (regLen - 1) / 2.0
src      = close
ySum     = math.sum(src, regLen)
yMean    = ySum / regLen
// Σ(x·y) with x = 0..n-1 (oldest→newest requires care: bar_index offsets)
float sxy = 0.0
float sxx = 0.0
for i = 0 to regLen - 1
    x  = regLen - 1 - i          // oldest bar gets x=0, current bar x=n-1
    dx = x - xMean
    sxy := sxy + dx * (src[i] - yMean)
    sxx := sxx + dx * dx
slope    = sxx > 0 ? sxy / sxx : 0.0
// residual variance → standard error of slope
float sse = 0.0
for i = 0 to regLen - 1
    x    = regLen - 1 - i
    yhat = yMean + slope * (x - xMean)
    e    = src[i] - yhat
    sse := sse + e * e
seSlope  = sxx > 0 and regLen > 2 ? math.sqrt((sse / (regLen - 2)) / sxx) : na
tStat    = not na(seSlope) and seSlope > 0 ? slope / seSlope : 0.0

// --- ADX (directional strength)
[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)

// --- Volatility regime: percentile rank of ATR over ~1 trading year
atr      = ta.atr(atrLen)
volPctile = ta.percentrank(atr, volLookback)
volBlowout = volPctile >= volCapPct

// ═══════════════════════════ REGIME CLASSIFIER ══════════════════════════════
// Trending: ER high AND (slope statistically significant OR ADX confirms).
// Ranging : ER low AND slope insignificant.
// Neither → "transition" (no new entries).
isTrending = er > erTrendTh and (math.abs(tStat) > tStatTh or adx > adxTh)
isRanging  = er < erTrendTh * 0.8 and math.abs(tStat) < tStatTh and adx < adxTh
regime     = volBlowout ? 0 : isTrending ? 1 : isRanging ? -1 : 0   // 1=trend, -1=range, 0=transition/blowout

// ═══════════════════════ SINGLE-STOCK DEFENSES ══════════════════════════════
// Relative strength: longs only when this name is outperforming the benchmark.
// Auto-disabled when the chart symbol IS the benchmark (ratio would be constant).
benchClose = request.security(rsSymbol, timeframe.period, close, barmerge.gaps_off, barmerge.lookahead_off)
rsRatio    = not na(benchClose) and benchClose > 0 ? close / benchClose : 1.0
rsSma      = ta.sma(rsRatio, rsLen)
// syminfo.ticker is a variable, not a function - compare the input string
// against both the plain ticker and the exchange-prefixed form
rsActive   = useRsFilter and rsSymbol != syminfo.ticker and rsSymbol != syminfo.tickerid
rsOk       = not rsActive or rsRatio > rsSma

// Overnight gap in ATR units (earnings-shock detector)
gapAtr     = atr[1] > 0 ? (open - close[1]) / atr[1] : 0.0
gapDay     = gapAtrMult > 0 and math.abs(gapAtr) > gapAtrMult

// ═══════════════════════════ TREND ENGINE ═══════════════════════════════════
// KAMA — adaptive baseline whose smoothing follows the Efficiency Ratio
fastSC   = 2.0 / (kamaFast + 1)
slowSC   = 2.0 / (kamaSlow + 1)
erK      = math.abs(close - close[kamaLen]) / math.max(math.sum(math.abs(close - close[1]), kamaLen), 1e-10)
sc       = math.pow(erK * (fastSC - slowSC) + slowSC, 2)
var float kama = na
kama    := na(kama[1]) ? close : kama[1] + sc * (close - kama[1])

// full-series versions stay at global scope: ta.* has to run on every bar or
// its history goes wrong when it sits inside an if block
donHiFull = ta.highest(high, donLen)
donLoFull = ta.lowest(low,  donLen)
donHi    = donHiFull[1]
donLo    = donLoFull[1]

trendLong  = isTrending and close > kama and slope > 0 and close > donHi
trendShort = isTrending and close < kama and slope < 0 and close < donLo

// ═══════════════════════ MEAN-REVERSION ENGINE ══════════════════════════════
basis    = ta.sma(close, zLen)
sd       = ta.stdev(close, zLen)
z        = sd > 0 ? (close - basis) / sd : 0.0
rsiF     = ta.rsi(close, rsiLen)

mrLong   = isRanging and z < -zEntry and rsiF < rsiOS
mrShort  = isRanging and z >  zEntry and rsiF > rsiOB

// ══════════════════════════════ RISK ENGINE ═════════════════════════════════
stopDist   = atrStopMult * atr
// volatility-targeted sizing: fixed dollar risk / stop distance,
// capped at maxNotionalPct of equity (ATR sizing over-allocates to quiet names)
riskDollar = strategy.equity * riskPct / 100.0
qtyRisk    = stopDist > 0 ? math.max(math.floor(riskDollar / stopDist), 0) : 0
qtyCap     = close > 0 ? math.floor(strategy.equity * maxNotionalPct / 100.0 / close) : 0
qty        = math.min(qtyRisk, qtyCap)

// track entry meta
var string tradeEngine = na     // "TREND" | "MR"
var int    barsInTrade = 0
var float  trailStop   = na
var float  stopLevel   = na     // the protective stop currently working

inLong  = strategy.position_size > 0
inShort = strategy.position_size < 0
flat    = strategy.position_size == 0

barsInTrade := flat ? 0 : barsInTrade + 1

// chandelier trail for trend trades
if inLong and tradeEngine == "TREND"
    newTrail = donHiFull - chandMult * atr
    trailStop := na(trailStop) ? newTrail : math.max(trailStop, newTrail)
if inShort and tradeEngine == "TREND"
    newTrail = donLoFull + chandMult * atr
    trailStop := na(trailStop) ? newTrail : math.min(trailStop, newTrail)
if flat
    trailStop := na
    stopLevel := na

// ═══════════════════════════════ ORDERS ═════════════════════════════════════
longSignal  = ((allowTrend and trendLong)  or (allowMR and mrLong)) and rsOk
shortSignal = ((allowTrend and trendShort) or (allowMR and mrShort)) and allowShorts

// entries (only when flat; no entries on gap-shock days — post-earnings
// bars have elevated adverse-selection risk)
if flat and qty > 0 and not volBlowout and not gapDay
    if longSignal
        tradeEngine := allowTrend and trendLong ? "TREND" : "MR"
        stopLevel := close - stopDist
        strategy.entry("L", strategy.long, qty = qty,
             alert_message = '{"action":"buy","ticker":"' + syminfo.ticker + '","engine":"' + tradeEngine + '","qty":' + str.tostring(qty) + ',"stop":' + str.tostring(close - stopDist, "#.####") + '}')
        strategy.exit("L-exit", from_entry = "L", stop = stopLevel,
             alert_message = '{"action":"exit","ticker":"' + syminfo.ticker + '","reason":"stop"}')
    else if shortSignal
        tradeEngine := allowTrend and trendShort ? "TREND" : "MR"
        stopLevel := close + stopDist
        strategy.entry("S", strategy.short, qty = qty,
             alert_message = '{"action":"sell","ticker":"' + syminfo.ticker + '","engine":"' + tradeEngine + '","qty":' + str.tostring(qty) + ',"stop":' + str.tostring(close + stopDist, "#.####") + '}')
        strategy.exit("S-exit", from_entry = "S", stop = stopLevel,
             alert_message = '{"action":"exit","ticker":"' + syminfo.ticker + '","reason":"stop"}')

// One protective stop per position, re-sent every bar under the same ID so it
// updates instead of stacking a second order. Trend trades ratchet it up with
// the chandelier trail; MR trades just keep the original ATR stop.
if inLong
    effStop = na(trailStop) ? stopLevel : math.max(nz(stopLevel, trailStop), trailStop)
    strategy.exit("L-exit", from_entry = "L", stop = effStop,
         alert_message = '{"action":"exit","ticker":"' + syminfo.ticker + '","reason":"stop-or-trail"}')
if inShort
    effStop = na(trailStop) ? stopLevel : math.min(nz(stopLevel, trailStop), trailStop)
    strategy.exit("S-exit", from_entry = "S", stop = effStop,
         alert_message = '{"action":"exit","ticker":"' + syminfo.ticker + '","reason":"stop-or-trail"}')

// trend trades also bail out if price loses the KAMA while the trend decays
if inLong and tradeEngine == "TREND" and close < kama and er < erTrendTh * 0.6
    strategy.close("L", comment = "regime-loss",
         alert_message = '{"action":"exit","ticker":"' + syminfo.ticker + '","reason":"regime"}')
if inShort and tradeEngine == "TREND" and close > kama and er < erTrendTh * 0.6
    strategy.close("S", comment = "regime-loss",
         alert_message = '{"action":"exit","ticker":"' + syminfo.ticker + '","reason":"regime"}')

// mean-reversion exits: z back to mean, RSI normalization, or time stop
if inLong and tradeEngine == "MR"
    if z > -zExit or barsInTrade >= mrTimeStop
        strategy.close("L", comment = z > -zExit ? "mean-hit" : "time-stop",
             alert_message = '{"action":"exit","ticker":"' + syminfo.ticker + '","reason":"mr-exit"}')
if inShort and tradeEngine == "MR"
    if z < zExit or barsInTrade >= mrTimeStop
        strategy.close("S", comment = z < zExit ? "mean-hit" : "time-stop",
             alert_message = '{"action":"exit","ticker":"' + syminfo.ticker + '","reason":"mr-exit"}')

// gap-shock exit: adverse overnight gap beyond threshold → get out.
// (An earnings miss that gaps through the stop; fills at this bar's close on
// historical bars — live, fire-and-exit happens the same session.)
if inLong and gapAtrMult > 0 and gapAtr < -gapAtrMult
    strategy.close("L", comment = "gap-shock",
         alert_message = '{"action":"exit","ticker":"' + syminfo.ticker + '","reason":"gap-shock"}')
if inShort and gapAtrMult > 0 and gapAtr > gapAtrMult
    strategy.close("S", comment = "gap-shock",
         alert_message = '{"action":"exit","ticker":"' + syminfo.ticker + '","reason":"gap-shock"}')

// volatility circuit breaker: flatten everything
if not flat and volBlowout
    strategy.close_all(comment = "vol-breaker",
         alert_message = '{"action":"exit","ticker":"' + syminfo.ticker + '","reason":"vol-circuit-breaker"}')

// ═══════════════════════════════ VISUALS ════════════════════════════════════
plot(kama, "KAMA", color = color.new(color.orange, 0), linewidth = 2)
plot(basis, "MR basis", color = color.new(color.gray, 40))
p1 = plot(basis + zEntry * sd, "Upper band", color = color.new(color.teal, 70))
p2 = plot(basis - zEntry * sd, "Lower band", color = color.new(color.teal, 70))
fill(p1, p2, color = color.new(color.teal, 95))
plot(inLong or inShort ? trailStop : na, "Trail stop", color = color.red, style = plot.style_linebr)

bgcolor(showRegime ? (volBlowout ? color.new(color.red, 85) : regime == 1 ? color.new(color.green, 92) : regime == -1 ? color.new(color.blue, 92) : na) : na, title = "Regime")

// stats table
var table t = table.new(position.top_right, 2, 7, border_width = 1)
if showTable and barstate.islast
    table.cell(t, 0, 0, "Regime",       text_size = size.small)
    table.cell(t, 1, 0, volBlowout ? "VOL BLOWOUT" : regime == 1 ? "TREND" : regime == -1 ? "RANGE" : "TRANSITION", text_size = size.small, text_color = regime == 1 ? color.green : regime == -1 ? color.blue : color.red)
    table.cell(t, 0, 1, "Eff. Ratio",   text_size = size.small)
    table.cell(t, 1, 1, str.tostring(er, "#.###"), text_size = size.small)
    table.cell(t, 0, 2, "Slope t-stat", text_size = size.small)
    table.cell(t, 1, 2, str.tostring(tStat, "#.##"), text_size = size.small)
    table.cell(t, 0, 3, "Z-score",      text_size = size.small)
    table.cell(t, 1, 3, str.tostring(z, "#.##"), text_size = size.small)
    table.cell(t, 0, 4, "Vol %ile",     text_size = size.small)
    table.cell(t, 1, 4, str.tostring(volPctile, "#.#"), text_size = size.small)
    table.cell(t, 0, 5, "Size (qty)",   text_size = size.small)
    table.cell(t, 1, 5, str.tostring(qty), text_size = size.small)
    table.cell(t, 0, 6, "Rel. strength", text_size = size.small)
    table.cell(t, 1, 6, not rsActive ? "off" : rsOk ? "LEADER" : "LAGGARD", text_size = size.small, text_color = not rsActive ? color.gray : rsOk ? color.green : color.red)
