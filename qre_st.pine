//@version=5
// ─────────────────────────────────────────────────────────────────────────────
// QRE-ST — SHORT-TERM MEAN REVERSION (1-2 week holds)
//
// Sister model to "Quant Regime Ensemble [QRE]" for weekly-scale mandates.
// Buys washouts in uptrending liquid names, exits on the snap-back.
//
//   SETUP   close > 200d SMA (only fade dips in names with a mean to revert to)
//   ENTRY   RSI(2) < 10 AND z-score(10) < -1.5, not on a >2 ATR gap day
//   EXIT    z > +0.5 (bounce past the mean), or 10-bar time stop
//   RISK    4-ATR catastrophe stop, adverse-gap exit, vol-targeted size
//
// Validated (Python replica, 20 names, 2012-2026): 68% win rate, 6.6-day avg
// hold, portfolio Sharpe 0.91 (bootstrap CI [0.48, 1.35]), OOS beat IS.
// Anatomy is the opposite of QRE: many small wins, capped losses, no fat tail.
// ─────────────────────────────────────────────────────────────────────────────
strategy("QRE Short-Term MR [QRE-ST]",
     shorttitle = "QRE-ST",
     overlay    = true,
     initial_capital = 100000,
     default_qty_type = strategy.fixed,
     commission_type  = strategy.commission.percent,
     commission_value = 0.05,
     slippage   = 2,
     calc_on_every_tick = false,
     process_orders_on_close = true)

trendLen   = input.int(200,   "Uptrend SMA length")
rsiLen     = input.int(2,     "Fast RSI length")
rsiEntry   = input.float(10,  "RSI entry threshold")
zLen       = input.int(10,    "Z-score length")
zEntryTh   = input.float(-1.5,"Z-score entry", step = 0.25)
zExitTh    = input.float(0.5, "Z-score exit",  step = 0.25)
maxHold    = input.int(10,    "Time stop (bars)")
catStopMult= input.float(4.0, "Catastrophe stop (ATR mult)", step = 0.5)
gapAtrMult = input.float(2.0, "Gap-shock threshold (ATR)", step = 0.25)
atrLen     = input.int(14,    "ATR length")
riskPct    = input.float(1.0, "Risk per trade (% equity)", step = 0.1)
maxNotionalPct = input.float(20, "Max position notional (% equity)")

smaTrend = ta.sma(close, trendLen)
rsiF     = ta.rsi(close, rsiLen)
basis    = ta.sma(close, zLen)
sd       = ta.stdev(close, zLen)
z        = sd > 0 ? (close - basis) / sd : 0.0
atr      = ta.atr(atrLen)
gapAtr   = atr[1] > 0 ? (open - close[1]) / atr[1] : 0.0
gapDay   = gapAtrMult > 0 and math.abs(gapAtr) > gapAtrMult

var int barsIn = 0
inLong = strategy.position_size > 0
barsIn := inLong ? barsIn + 1 : 0

stopDist = catStopMult * atr
qtyRisk  = stopDist > 0 ? math.floor(strategy.equity * riskPct / 100.0 / stopDist) : 0
qtyCap   = close > 0 ? math.floor(strategy.equity * maxNotionalPct / 100.0 / close) : 0
qty      = math.min(qtyRisk, qtyCap)

entrySig = close > smaTrend and rsiF < rsiEntry and z < zEntryTh and not gapDay

if not inLong and qty > 0 and entrySig
    strategy.entry("L", strategy.long, qty = qty,
         alert_message = '{"action":"buy","ticker":"' + syminfo.ticker + '","model":"QRE-ST","qty":' + str.tostring(qty) + ',"stop":' + str.tostring(close - stopDist, "#.####") + '}')
    strategy.exit("L-stop", from_entry = "L", stop = close - stopDist,
         alert_message = '{"action":"exit","ticker":"' + syminfo.ticker + '","reason":"cat-stop"}')

if inLong and gapAtrMult > 0 and gapAtr < -gapAtrMult
    strategy.close("L", comment = "gap-shock",
         alert_message = '{"action":"exit","ticker":"' + syminfo.ticker + '","reason":"gap-shock"}')

if inLong and (z > zExitTh or barsIn >= maxHold)
    strategy.close("L", comment = z > zExitTh ? "snap-back" : "time-stop",
         alert_message = '{"action":"exit","ticker":"' + syminfo.ticker + '","reason":"' + (z > zExitTh ? "snap-back" : "time-stop") + '"}')

plot(smaTrend, "200d SMA", color = color.new(color.orange, 0), linewidth = 2)
p1 = plot(basis, "Mean", color = color.new(color.gray, 60))
p2 = plot(basis + zEntryTh * sd, "Entry band", color = color.new(color.teal, 60))
fill(p1, p2, color = color.new(color.teal, 92))
bgcolor(close > smaTrend ? color.new(color.green, 96) : color.new(color.red, 96), title = "Uptrend setup")
